# Filled by: uv run python -m app.database_setup bootstrap --container postgres
# Do not commit the actual .env file.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/skill_forge
# Optional absolute path; retain the original encryption key when migrating.
# SKILL_FORGE_DATA_DIR=D:/project/skill-forge/backend/data
# Shared SellerSprite MCP key: server-side only, never a per-user image/text API key.
# For LAN deployments, place it in the protected deployment.env instead.
# SELLERSPRITE_MCP_SECRET_KEY=
# Shared Xiyou MCP bearer token, stored only on the server.
# XIYOU_MCP_TOKEN=
